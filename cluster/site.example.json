{
  "kubeContext": "<kubectl context>",
  "namespace": "<namespace>",
  "bundle": "<local bundle directory>",
  "baseImage": "<image with python3 and coreutils>@sha256:<digest>",
  "cpus": 2,
  "memory": "8Gi",
  "scratchSize": "8Gi",
  "nodeSelector": {"<label>": "<value>"},
